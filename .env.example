# .env.example
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in values to enable
# optional features. NEVER commit real secrets. Vite only exposes variables
# prefixed with VITE_ to the browser, so never put private API keys here.
# ---------------------------------------------------------------------------

# Optional: contact-form backend endpoint (e.g. a Formspree / Getform / your own
# serverless function URL). When set, the Contact Lounge form POSTs to it.
# When unset, the form validates input and honestly shows that no mail service
# is configured, offering the direct email address instead.
VITE_CONTACT_ENDPOINT=
